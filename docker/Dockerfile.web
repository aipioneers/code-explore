# Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy solution and project files
COPY EnterpriseApp.sln .
COPY Directory.Build.props .
COPY src/EnterpriseApp.Web/EnterpriseApp.Web.csproj src/EnterpriseApp.Web/
COPY src/EnterpriseApp.Shared/EnterpriseApp.Shared.csproj src/EnterpriseApp.Shared/

# Restore dependencies
RUN dotnet restore src/EnterpriseApp.Web/EnterpriseApp.Web.csproj

# Copy source code
COPY src/EnterpriseApp.Web/ src/EnterpriseApp.Web/
COPY src/EnterpriseApp.Shared/ src/EnterpriseApp.Shared/

# Build and publish
RUN dotnet publish src/EnterpriseApp.Web/EnterpriseApp.Web.csproj -c Release -o /app/publish --no-restore

# Runtime stage - using nginx to serve static files
FROM nginx:alpine AS runtime

# Copy nginx configuration
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Copy published Blazor WebAssembly files
COPY --from=build /app/publish/wwwroot /usr/share/nginx/html

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
