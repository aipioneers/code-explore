@page "/inventory"
@attribute [Authorize(Roles = "Administrator,Manager,Lager")]
@inject HttpClientService Http
@inject IToastService ToastService

<PageTitle>Inventory - EnterpriseApp</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Inventory Management</h1>
    <div class="btn-group">
        <button class="btn btn-primary" @onclick="() => ShowAdjustmentModal()">
            <i class="bi bi-plus-minus me-1"></i> Stock Adjustment
        </button>
        <a href="inventory/counts" class="btn btn-outline-secondary">
            <i class="bi bi-clipboard-check me-1"></i> Inventory Counts
        </a>
    </div>
</div>

<!-- Quick Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card bg-danger text-white">
            <div class="card-body">
                <h6 class="card-title">Out of Stock</h6>
                <h2 class="mb-0">@_outOfStockCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning">
            <div class="card-body">
                <h6 class="card-title">Low Stock</h6>
                <h2 class="mb-0">@_lowStockCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h6 class="card-title">In Stock</h6>
                <h2 class="mb-0">@_inStockCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h6 class="card-title">Total Stock Value</h6>
                <h2 class="mb-0">@_totalValue.ToString("C")</h2>
            </div>
        </div>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <button class="nav-link @(_activeTab == "lowstock" ? "active" : "")" @onclick='() => SetTab("lowstock")'>
            <i class="bi bi-exclamation-triangle me-1"></i> Low Stock Alerts
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_activeTab == "movements" ? "active" : "")" @onclick='() => SetTab("movements")'>
            <i class="bi bi-arrow-left-right me-1"></i> Stock Movements
        </button>
    </li>
</ul>

@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_activeTab == "lowstock")
{
    @if (_lowStockProducts.Any())
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th class="text-center">Current Stock</th>
                            <th class="text-center">Threshold</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in _lowStockProducts)
                        {
                            <tr>
                                <td>
                                    <div class="fw-medium">@product.Name</div>
                                    <small class="text-muted"><code>@product.Sku</code></small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-@(product.IsOutOfStock ? "danger" : "warning") fs-6">
                                        @product.CurrentStock
                                    </span>
                                </td>
                                <td class="text-center">@product.LowStockThreshold</td>
                                <td>
                                    @if (product.IsOutOfStock)
                                    {
                                        <span class="text-danger"><i class="bi bi-x-circle me-1"></i>Out of Stock</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowAdjustmentModal(product.Id)">
                                        Adjust Stock
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-check-circle display-1 text-success"></i>
            <p class="text-muted mt-3">All products are well stocked!</p>
        </div>
    }
}
else if (_activeTab == "movements")
{
    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <select class="form-select" @bind="_movementTypeFilter" @bind:after="LoadMovements">
                        <option value="">All Movement Types</option>
                        <option value="PurchaseReceived">Purchase Received</option>
                        <option value="SaleShipped">Sale Shipped</option>
                        <option value="AdjustmentIn">Adjustment In</option>
                        <option value="AdjustmentOut">Adjustment Out</option>
                        <option value="CustomerReturn">Customer Return</option>
                        <option value="InventoryCount">Inventory Count</option>
                        <option value="Damaged">Damaged</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <input type="date" class="form-control" @bind="_fromDate" @bind:after="LoadMovements" />
                </div>
                <div class="col-md-3">
                    <input type="date" class="form-control" @bind="_toDate" @bind:after="LoadMovements" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear Filters</button>
                </div>
            </div>
        </div>
    </div>

    @if (_movements.Any())
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Product</th>
                            <th>Type</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-center">Before</th>
                            <th class="text-center">After</th>
                            <th>Reference</th>
                            <th>By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movement in _movements)
                        {
                            <tr>
                                <td>@movement.CreatedAt.ToString("g")</td>
                                <td>
                                    <div>@movement.ProductName</div>
                                    <small class="text-muted">@movement.ProductSku</small>
                                </td>
                                <td>
                                    <span class="badge bg-@GetMovementTypeColor(movement.Type)">
                                        @movement.Type
                                    </span>
                                </td>
                                <td class="text-end @(movement.Quantity >= 0 ? "text-success" : "text-danger")">
                                    @(movement.Quantity >= 0 ? "+" : "")@movement.Quantity
                                </td>
                                <td class="text-center">@movement.QuantityBefore</td>
                                <td class="text-center">@movement.QuantityAfter</td>
                                <td>@(movement.ReferenceNumber ?? "—")</td>
                                <td>@(movement.CreatedByUsername ?? "System")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <p class="text-muted mt-3">No stock movements found.</p>
        </div>
    }
}

<!-- Stock Adjustment Modal -->
@if (_showAdjustmentModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Stock Adjustment</h5>
                    <button type="button" class="btn-close" @onclick="HideAdjustmentModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Adjustment Type</label>
                        <select class="form-select" @bind="_adjustmentType">
                            <option value="AdjustmentIn">Add Stock (+)</option>
                            <option value="AdjustmentOut">Remove Stock (-)</option>
                            <option value="Damaged">Damaged</option>
                            <option value="Lost">Lost/Missing</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantity</label>
                        <input type="number" class="form-control" @bind="_adjustmentQuantity" min="1" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reason</label>
                        <input type="text" class="form-control" @bind="_adjustmentReason" />
                    </div>
                    <div>
                        <label class="form-label">Notes (optional)</label>
                        <textarea class="form-control" @bind="_adjustmentNotes" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideAdjustmentModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitAdjustment" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Submit Adjustment
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string _activeTab = "lowstock";
    private bool _isLoading = true;

    // Stats
    private int _outOfStockCount = 0;
    private int _lowStockCount = 0;
    private int _inStockCount = 0;
    private decimal _totalValue = 0;

    // Low stock
    private List<LowStockProductDto> _lowStockProducts = new();

    // Movements
    private List<StockMovementDto> _movements = new();
    private string _movementTypeFilter = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    // Adjustment modal
    private bool _showAdjustmentModal = false;
    private Guid? _adjustmentProductId;
    private string _adjustmentType = "AdjustmentIn";
    private int _adjustmentQuantity = 1;
    private string _adjustmentReason = string.Empty;
    private string _adjustmentNotes = string.Empty;
    private bool _isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLowStockProducts();
    }

    private async Task SetTab(string tab)
    {
        _activeTab = tab;
        if (tab == "lowstock")
            await LoadLowStockProducts();
        else if (tab == "movements")
            await LoadMovements();
    }

    private async Task LoadLowStockProducts()
    {
        _isLoading = true;
        try
        {
            var response = await Http.GetAsync<List<LowStockProductDto>>("api/inventory/low-stock?includeOutOfStock=true");
            if (response.Success && response.Data != null)
            {
                _lowStockProducts = response.Data;
                _outOfStockCount = _lowStockProducts.Count(p => p.IsOutOfStock);
                _lowStockCount = _lowStockProducts.Count(p => !p.IsOutOfStock);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadMovements()
    {
        _isLoading = true;
        try
        {
            var url = "api/inventory/movements?pageSize=50";
            if (!string.IsNullOrEmpty(_movementTypeFilter))
                url += $"&type={_movementTypeFilter}";
            if (_fromDate.HasValue)
                url += $"&fromDate={_fromDate.Value:yyyy-MM-dd}";
            if (_toDate.HasValue)
                url += $"&toDate={_toDate.Value:yyyy-MM-dd}";

            var response = await Http.GetAsync<PaginatedResponse<StockMovementDto>>(url);
            if (response.Success && response.Data != null)
            {
                _movements = response.Data.Items.ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ClearFilters()
    {
        _movementTypeFilter = string.Empty;
        _fromDate = null;
        _toDate = null;
        await LoadMovements();
    }

    private void ShowAdjustmentModal(Guid? productId = null)
    {
        _adjustmentProductId = productId;
        _adjustmentType = "AdjustmentIn";
        _adjustmentQuantity = 1;
        _adjustmentReason = string.Empty;
        _adjustmentNotes = string.Empty;
        _showAdjustmentModal = true;
    }

    private void HideAdjustmentModal()
    {
        _showAdjustmentModal = false;
        _isSubmitting = false;
    }

    private async Task SubmitAdjustment()
    {
        if (_adjustmentProductId == null || _adjustmentQuantity <= 0)
        {
            ToastService.ShowError("Please select a product and enter a valid quantity");
            return;
        }

        _isSubmitting = true;
        try
        {
            var response = await Http.PostAsync<object>("api/inventory/adjustments", new
            {
                productId = _adjustmentProductId,
                quantity = _adjustmentQuantity,
                type = _adjustmentType,
                reason = _adjustmentReason,
                notes = _adjustmentNotes
            });

            if (response.Success)
            {
                ToastService.ShowSuccess("Stock adjustment created");
                HideAdjustmentModal();
                await LoadLowStockProducts();
            }
            else
            {
                ToastService.ShowError(response.Message ?? "Failed to create adjustment");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string GetMovementTypeColor(string type) => type switch
    {
        "PurchaseReceived" or "AdjustmentIn" or "CustomerReturn" or "TransferIn" => "success",
        "SaleShipped" or "AdjustmentOut" or "TransferOut" or "SupplierReturn" => "primary",
        "Damaged" or "Lost" => "danger",
        "InventoryCount" => "info",
        _ => "secondary"
    };

    // DTO classes
    private class LowStockProductDto
    {
        public Guid Id { get; set; }
        public string Sku { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public int CurrentStock { get; set; }
        public int LowStockThreshold { get; set; }
        public bool IsOutOfStock { get; set; }
    }

    private class StockMovementDto
    {
        public Guid Id { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public string ProductSku { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public int Quantity { get; set; }
        public int QuantityBefore { get; set; }
        public int QuantityAfter { get; set; }
        public string? ReferenceNumber { get; set; }
        public string? CreatedByUsername { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    private class PaginatedResponse<T>
    {
        public IReadOnlyList<T> Items { get; set; } = Array.Empty<T>();
        public int TotalCount { get; set; }
    }
}
