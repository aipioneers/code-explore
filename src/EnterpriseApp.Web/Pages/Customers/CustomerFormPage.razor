@page "/customers/new"
@page "/customers/{Id:guid}/edit"
@attribute [Authorize]
@inject HttpClientService Http
@inject NavigationManager Navigation
@inject IToastService ToastService

<PageTitle>@(_isEditMode ? "Edit Customer" : "New Customer") - EnterpriseApp</PageTitle>

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="customers">Customers</a></li>
        @if (_isEditMode && _model != null)
        {
            <li class="breadcrumb-item"><a href="customers/@Id">@_originalCustomerNumber</a></li>
            <li class="breadcrumb-item active">Edit</li>
        }
        else
        {
            <li class="breadcrumb-item active">New Customer</li>
        }
    </ol>
</nav>

<h1 class="mb-4">@(_isEditMode ? "Edit Customer" : "New Customer")</h1>

@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_isEditMode && _model == null)
{
    <div class="text-center py-5">
        <i class="bi bi-exclamation-circle display-1 text-warning"></i>
        <p class="text-muted mt-3">Customer not found.</p>
        <a href="customers" class="btn btn-primary">Back to Customers</a>
    </div>
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="row g-4">
            <!-- Main Form -->
            <div class="col-lg-8">
                <!-- Company Info -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Company Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Company Name</label>
                            <InputText @bind-Value="_model!.CompanyName" class="form-control"
                                       placeholder="Leave empty for individual customers" />
                            <div class="form-text">If provided, this will be used as the display name.</div>
                        </div>
                    </div>
                </div>

                <!-- Contact Info -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Contact Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">First Name <span class="text-danger">*</span></label>
                                <InputText @bind-Value="_model!.FirstName" class="form-control" />
                                <ValidationMessage For="() => _model.FirstName" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Last Name <span class="text-danger">*</span></label>
                                <InputText @bind-Value="_model!.LastName" class="form-control" />
                                <ValidationMessage For="() => _model.LastName" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email <span class="text-danger">*</span></label>
                                <InputText @bind-Value="_model!.Email" class="form-control" type="email" />
                                <ValidationMessage For="() => _model.Email" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone</label>
                                <InputText @bind-Value="_model!.Phone" class="form-control" type="tel" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Mobile</label>
                                <InputText @bind-Value="_model!.Mobile" class="form-control" type="tel" />
                            </div>
                            @if (_isEditMode)
                            {
                                <div class="col-md-6">
                                    <label class="form-label">Fax</label>
                                    <InputText @bind-Value="_model!.Fax" class="form-control" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Website</label>
                                    <InputText @bind-Value="_model!.Website" class="form-control" type="url"
                                               placeholder="https://example.com" />
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Notes</h5>
                    </div>
                    <div class="card-body">
                        <InputTextArea @bind-Value="_model!.Notes" class="form-control" rows="4"
                                       placeholder="Add any additional notes about this customer..." />
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Business Settings -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Business Settings</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Tax ID</label>
                            <InputText @bind-Value="_model!.TaxId" class="form-control"
                                       placeholder="e.g., EIN, VAT number" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Credit Limit</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <InputNumber @bind-Value="_model!.CreditLimit" class="form-control"
                                             min="0" step="0.01" />
                            </div>
                            <div class="form-text">Leave empty for no limit.</div>
                        </div>
                        <div>
                            <label class="form-label">Payment Terms (Days)</label>
                            <InputNumber @bind-Value="_model!.PaymentTermsDays" class="form-control"
                                         min="0" max="365" />
                            <ValidationMessage For="() => _model.PaymentTermsDays" class="text-danger small" />
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="card">
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                @(_isEditMode ? "Save Changes" : "Create Customer")
                            </button>
                            <a href="@(_isEditMode ? $"customers/{Id}" : "customers")" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private CustomerFormModel? _model;
    private bool _isEditMode => Id.HasValue;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string _originalCustomerNumber = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (_isEditMode)
        {
            await LoadCustomer();
        }
        else
        {
            _model = new CustomerFormModel();
            _isLoading = false;
        }
    }

    private async Task LoadCustomer()
    {
        try
        {
            var response = await Http.GetAsync<CustomerDetailDto>($"api/customers/{Id}");

            if (response.Success && response.Data != null)
            {
                var customer = response.Data;
                _originalCustomerNumber = customer.CustomerNumber;
                _model = new CustomerFormModel
                {
                    CompanyName = customer.CompanyName,
                    FirstName = customer.FirstName,
                    LastName = customer.LastName,
                    Email = customer.Email,
                    Phone = customer.Phone,
                    Mobile = customer.Mobile,
                    Fax = customer.Fax,
                    Website = customer.Website,
                    TaxId = customer.TaxId,
                    Notes = customer.Notes,
                    CreditLimit = customer.CreditLimit,
                    PaymentTermsDays = customer.PaymentTermsDays
                };
            }
            else if (response.StatusCode == 404)
            {
                _model = null;
            }
            else
            {
                ToastService.ShowError(response.Message ?? "Failed to load customer");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading customer: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (_model == null)
            return;

        _isSaving = true;

        try
        {
            ApiResponse<CustomerDto> response;

            if (_isEditMode)
            {
                var updateRequest = new UpdateCustomerRequest
                {
                    CompanyName = _model.CompanyName,
                    FirstName = _model.FirstName,
                    LastName = _model.LastName,
                    Email = _model.Email,
                    Phone = _model.Phone,
                    Mobile = _model.Mobile,
                    Fax = _model.Fax,
                    Website = _model.Website,
                    TaxId = _model.TaxId,
                    Notes = _model.Notes,
                    CreditLimit = _model.CreditLimit,
                    PaymentTermsDays = _model.PaymentTermsDays
                };
                response = await Http.PutAsync<CustomerDto>($"api/customers/{Id}", updateRequest);
            }
            else
            {
                var createRequest = new CreateCustomerRequest
                {
                    CompanyName = _model.CompanyName,
                    FirstName = _model.FirstName,
                    LastName = _model.LastName,
                    Email = _model.Email,
                    Phone = _model.Phone,
                    Mobile = _model.Mobile,
                    TaxId = _model.TaxId,
                    Notes = _model.Notes,
                    CreditLimit = _model.CreditLimit,
                    PaymentTermsDays = _model.PaymentTermsDays
                };
                response = await Http.PostAsync<CustomerDto>("api/customers", createRequest);
            }

            if (response.Success && response.Data != null)
            {
                ToastService.ShowSuccess(_isEditMode
                    ? "Customer updated successfully"
                    : "Customer created successfully");
                Navigation.NavigateTo($"customers/{response.Data.Id}");
            }
            else
            {
                ToastService.ShowError(response.Message ?? "Failed to save customer");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error saving customer: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Form model
    private class CustomerFormModel
    {
        public string? CompanyName { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "First name is required")]
        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "First name must not exceed 100 characters")]
        public string FirstName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Last name is required")]
        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "Last name must not exceed 100 characters")]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Please enter a valid email address")]
        [System.ComponentModel.DataAnnotations.StringLength(256, ErrorMessage = "Email must not exceed 256 characters")]
        public string Email { get; set; } = string.Empty;

        public string? Phone { get; set; }
        public string? Mobile { get; set; }
        public string? Fax { get; set; }
        public string? Website { get; set; }
        public string? TaxId { get; set; }
        public string? Notes { get; set; }
        public decimal? CreditLimit { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0, 365, ErrorMessage = "Payment terms must be between 0 and 365 days")]
        public int PaymentTermsDays { get; set; } = 30;
    }

    // DTO classes
    private class CustomerDetailDto
    {
        public string CustomerNumber { get; set; } = string.Empty;
        public string? CompanyName { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string? Mobile { get; set; }
        public string? Fax { get; set; }
        public string? Website { get; set; }
        public string? TaxId { get; set; }
        public string? Notes { get; set; }
        public decimal? CreditLimit { get; set; }
        public int PaymentTermsDays { get; set; }
    }

    private class CustomerDto
    {
        public Guid Id { get; set; }
    }

    private class CreateCustomerRequest
    {
        public string? CompanyName { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string? Mobile { get; set; }
        public string? TaxId { get; set; }
        public string? Notes { get; set; }
        public decimal? CreditLimit { get; set; }
        public int PaymentTermsDays { get; set; } = 30;
    }

    private class UpdateCustomerRequest
    {
        public string? CompanyName { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string? Mobile { get; set; }
        public string? Fax { get; set; }
        public string? Website { get; set; }
        public string? TaxId { get; set; }
        public string? Notes { get; set; }
        public decimal? CreditLimit { get; set; }
        public int PaymentTermsDays { get; set; } = 30;
    }
}
