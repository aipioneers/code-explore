@page "/customers"
@attribute [Authorize]
@inject HttpClientService Http
@inject NavigationManager Navigation
@inject IToastService ToastService

<PageTitle>Customers - EnterpriseApp</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Customers</h1>
    <a href="customers/new" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> New Customer
    </a>
</div>

<!-- Search and Filters -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search customers..."
                           @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                    @if (!string.IsNullOrEmpty(_searchTerm))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="_statusFilter" @bind:after="LoadCustomers">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Suspended">Suspended</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="_sortBy" @bind:after="LoadCustomers">
                    <option value="">Sort by Name</option>
                    <option value="customernumber">Customer Number</option>
                    <option value="companyname">Company Name</option>
                    <option value="email">Email</option>
                    <option value="createdat">Created Date</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="ToggleSortDirection">
                    <i class="bi @(_sortDesc ? "bi-sort-down" : "bi-sort-up")"></i>
                    @(_sortDesc ? "Desc" : "Asc")
                </button>
            </div>
        </div>
    </div>
</div>

@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_customers?.Items.Any() != true)
{
    <div class="text-center py-5">
        <i class="bi bi-people display-1 text-muted"></i>
        <p class="text-muted mt-3">
            @if (!string.IsNullOrEmpty(_searchTerm) || !string.IsNullOrEmpty(_statusFilter))
            {
                <text>No customers match your search criteria.</text>
            }
            else
            {
                <text>No customers yet. Create your first customer!</text>
            }
        </p>
        @if (string.IsNullOrEmpty(_searchTerm) && string.IsNullOrEmpty(_statusFilter))
        {
            <a href="customers/new" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Create Customer
            </a>
        }
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Customer #</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in _customers.Items)
                    {
                        <tr class="cursor-pointer" @onclick="() => ViewCustomer(customer.Id)">
                            <td>
                                <code>@customer.CustomerNumber</code>
                            </td>
                            <td>
                                <div class="fw-medium">@customer.DisplayName</div>
                                @if (!string.IsNullOrEmpty(customer.CompanyName) && customer.CompanyName != customer.DisplayName)
                                {
                                    <small class="text-muted">@customer.FullName</small>
                                }
                            </td>
                            <td>
                                <a href="mailto:@customer.Email" @onclick:stopPropagation="true">
                                    @customer.Email
                                </a>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(customer.Phone))
                                {
                                    <a href="tel:@customer.Phone" @onclick:stopPropagation="true">
                                        @customer.Phone
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@GetStatusColor(customer.Status)">
                                    @customer.Status
                                </span>
                            </td>
                            <td>
                                <span title="@customer.CreatedAt.ToString("F")">
                                    @customer.CreatedAt.ToString("MMM d, yyyy")
                                </span>
                            </td>
                            <td class="text-end" @onclick:stopPropagation="true">
                                <div class="btn-group btn-group-sm">
                                    <a href="customers/@customer.Id" class="btn btn-outline-primary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="customers/@customer.Id/edit" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button class="btn btn-outline-danger" title="Delete"
                                            @onclick="() => ConfirmDelete(customer)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (_customers.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Customer pagination">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted">
                    Showing @((_pageNumber - 1) * _pageSize + 1) to
                    @Math.Min(_pageNumber * _pageSize, _customers.TotalCount) of
                    @_customers.TotalCount customers
                </div>
                <ul class="pagination mb-0">
                    <li class="page-item @(!_customers.HasPreviousPage ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(_pageNumber - 1)"
                                disabled="@(!_customers.HasPreviousPage)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>
                    @for (int i = GetStartPage(); i <= GetEndPage(); i++)
                    {
                        var pageNum = i;
                        <li class="page-item @(pageNum == _pageNumber ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(pageNum)">
                                @pageNum
                            </button>
                        </li>
                    }
                    <li class="page-item @(!_customers.HasNextPage ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(_pageNumber + 1)"
                                disabled="@(!_customers.HasNextPage)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </nav>
    }
}

<!-- Delete Confirmation Modal -->
@if (_customerToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Customer</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@_customerToDelete.DisplayName</strong>?</p>
                    <p class="text-muted mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteCustomer" disabled="@_isDeleting">
                        @if (_isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .cursor-pointer {
        cursor: pointer;
    }

    .cursor-pointer:hover {
        background-color: var(--bs-table-hover-bg);
    }
</style>

@code {
    private PaginatedResponse<CustomerDto>? _customers;
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _sortBy = string.Empty;
    private bool _sortDesc = false;
    private int _pageNumber = 1;
    private int _pageSize = 10;
    private CustomerDto? _customerToDelete;
    private bool _isDeleting = false;
    private System.Timers.Timer? _searchDebounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var url = $"api/customers?pageNumber={_pageNumber}&pageSize={_pageSize}";

            if (!string.IsNullOrWhiteSpace(_searchTerm))
                url += $"&search={Uri.EscapeDataString(_searchTerm)}";

            if (!string.IsNullOrWhiteSpace(_statusFilter))
                url += $"&status={_statusFilter}";

            if (!string.IsNullOrWhiteSpace(_sortBy))
                url += $"&sortBy={_sortBy}";

            url += $"&sortDesc={_sortDesc}";

            var response = await Http.GetAsync<PaginatedResponse<CustomerDto>>(url);

            if (response.Success && response.Data != null)
            {
                _customers = response.Data;
            }
            else
            {
                ToastService.ShowError(response.Message ?? "Failed to load customers");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading customers: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        _searchDebounceTimer?.Stop();
        _searchDebounceTimer?.Dispose();

        _searchDebounceTimer = new System.Timers.Timer(300);
        _searchDebounceTimer.Elapsed += async (s, args) =>
        {
            _searchDebounceTimer?.Stop();
            _pageNumber = 1;
            await InvokeAsync(LoadCustomers);
        };
        _searchDebounceTimer.AutoReset = false;
        _searchDebounceTimer.Start();
    }

    private async Task ClearSearch()
    {
        _searchTerm = string.Empty;
        _pageNumber = 1;
        await LoadCustomers();
    }

    private async Task ToggleSortDirection()
    {
        _sortDesc = !_sortDesc;
        await LoadCustomers();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > (_customers?.TotalPages ?? 1))
            return;

        _pageNumber = page;
        await LoadCustomers();
    }

    private int GetStartPage()
    {
        var totalPages = _customers?.TotalPages ?? 1;
        var start = Math.Max(1, _pageNumber - 2);
        return Math.Min(start, Math.Max(1, totalPages - 4));
    }

    private int GetEndPage()
    {
        var totalPages = _customers?.TotalPages ?? 1;
        return Math.Min(totalPages, GetStartPage() + 4);
    }

    private void ViewCustomer(Guid id)
    {
        Navigation.NavigateTo($"customers/{id}");
    }

    private void ConfirmDelete(CustomerDto customer)
    {
        _customerToDelete = customer;
    }

    private void CancelDelete()
    {
        _customerToDelete = null;
        _isDeleting = false;
    }

    private async Task DeleteCustomer()
    {
        if (_customerToDelete == null)
            return;

        _isDeleting = true;

        try
        {
            var response = await Http.DeleteAsync<object>($"api/customers/{_customerToDelete.Id}");

            if (response.Success)
            {
                ToastService.ShowSuccess($"Customer {_customerToDelete.DisplayName} deleted successfully");
                _customerToDelete = null;
                await LoadCustomers();
            }
            else
            {
                ToastService.ShowError(response.Message ?? "Failed to delete customer");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting customer: {ex.Message}");
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private static string GetStatusColor(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "active" => "success",
            "inactive" => "secondary",
            "suspended" => "warning",
            _ => "secondary"
        };
    }

    public void Dispose()
    {
        _searchDebounceTimer?.Dispose();
    }

    // DTO class (matches API response)
    private class CustomerDto
    {
        public Guid Id { get; set; }
        public string CustomerNumber { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string? CompanyName { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
    }
}
