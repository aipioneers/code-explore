@page "/customers/{Id:guid}"
@attribute [Authorize]
@inject HttpClientService Http
@inject NavigationManager Navigation
@inject IToastService ToastService

<PageTitle>@(_customer?.DisplayName ?? "Customer Details") - EnterpriseApp</PageTitle>

@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_customer == null)
{
    <div class="text-center py-5">
        <i class="bi bi-exclamation-circle display-1 text-warning"></i>
        <p class="text-muted mt-3">Customer not found.</p>
        <a href="customers" class="btn btn-primary">Back to Customers</a>
    </div>
}
else
{
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="customers">Customers</a></li>
                    <li class="breadcrumb-item active">@_customer.CustomerNumber</li>
                </ol>
            </nav>
            <h1 class="mb-1">@_customer.DisplayName</h1>
            <div class="text-muted">
                <code>@_customer.CustomerNumber</code>
                <span class="mx-2">•</span>
                <span class="badge bg-@GetStatusColor(_customer.Status)">@_customer.Status</span>
            </div>
        </div>
        <div class="btn-group">
            <a href="customers/@Id/edit" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <button class="btn btn-outline-danger" @onclick="ConfirmDelete">
                <i class="bi bi-trash me-1"></i> Delete
            </button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Info Card -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Contact Information</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @if (!string.IsNullOrEmpty(_customer.CompanyName))
                        {
                            <div class="col-md-6">
                                <label class="text-muted small">Company</label>
                                <div class="fw-medium">@_customer.CompanyName</div>
                            </div>
                        }
                        <div class="col-md-6">
                            <label class="text-muted small">Full Name</label>
                            <div class="fw-medium">@_customer.FirstName @_customer.LastName</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Email</label>
                            <div>
                                <a href="mailto:@_customer.Email">@_customer.Email</a>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Phone</label>
                            <div>
                                @if (!string.IsNullOrEmpty(_customer.Phone))
                                {
                                    <a href="tel:@_customer.Phone">@_customer.Phone</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Mobile</label>
                            <div>
                                @if (!string.IsNullOrEmpty(_customer.Mobile))
                                {
                                    <a href="tel:@_customer.Mobile">@_customer.Mobile</a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Fax</label>
                            <div>@(_customer.Fax ?? "—")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(_customer.Website))
                        {
                            <div class="col-12">
                                <label class="text-muted small">Website</label>
                                <div>
                                    <a href="@_customer.Website" target="_blank" rel="noopener">
                                        @_customer.Website <i class="bi bi-box-arrow-up-right small"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Addresses Card -->
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Addresses</h5>
                    <button class="btn btn-sm btn-outline-primary" @onclick="ShowAddAddressModal">
                        <i class="bi bi-plus-lg me-1"></i> Add Address
                    </button>
                </div>
                <div class="card-body">
                    @if (_customer.Addresses.Any())
                    {
                        <div class="row g-3">
                            @foreach (var address in _customer.Addresses)
                            {
                                <div class="col-md-6">
                                    <div class="border rounded p-3 h-100 position-relative">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span class="badge bg-secondary">@address.Type</span>
                                            @if (address.IsDefault)
                                            {
                                                <span class="badge bg-primary">Default</span>
                                            }
                                        </div>
                                        <address class="mb-0">
                                            @address.Street<br />
                                            @if (!string.IsNullOrEmpty(address.AdditionalLine))
                                            {
                                                @address.AdditionalLine<br />
                                            }
                                            @address.City, @address.State @address.PostalCode<br />
                                            @address.Country
                                        </address>
                                        <div class="mt-2 pt-2 border-top">
                                            <button class="btn btn-sm btn-link text-danger p-0"
                                                    @onclick="() => ConfirmDeleteAddress(address)">
                                                <i class="bi bi-trash me-1"></i> Remove
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">No addresses added yet.</p>
                    }
                </div>
            </div>

            <!-- Notes Card -->
            @if (!string.IsNullOrEmpty(_customer.Notes))
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Notes</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-0" style="white-space: pre-wrap;">@_customer.Notes</p>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Business Info Card -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Business Information</h5>
                </div>
                <div class="card-body">
                    <dl class="mb-0">
                        <dt class="text-muted small">Tax ID</dt>
                        <dd>@(_customer.TaxId ?? "—")</dd>

                        <dt class="text-muted small">Credit Limit</dt>
                        <dd>
                            @if (_customer.CreditLimit.HasValue)
                            {
                                @_customer.CreditLimit.Value.ToString("C")
                            }
                            else
                            {
                                <span>No limit</span>
                            }
                        </dd>

                        <dt class="text-muted small">Payment Terms</dt>
                        <dd class="mb-0">@_customer.PaymentTermsDays days</dd>
                    </dl>
                </div>
            </div>

            <!-- Timestamps Card -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Record Info</h5>
                </div>
                <div class="card-body">
                    <dl class="mb-0">
                        <dt class="text-muted small">Created</dt>
                        <dd>@_customer.CreatedAt.ToString("F")</dd>

                        @if (_customer.ModifiedAt.HasValue)
                        {
                            <dt class="text-muted small">Last Modified</dt>
                            <dd class="mb-0">@_customer.ModifiedAt.Value.ToString("F")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Customer Modal -->
@if (_showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Customer</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@_customer?.DisplayName</strong>?</p>
                    <p class="text-muted mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteCustomer" disabled="@_isDeleting">
                        @if (_isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Address Modal -->
@if (_addressToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Remove Address</h5>
                    <button type="button" class="btn-close" @onclick="CancelDeleteAddress"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to remove this @_addressToDelete.Type address?</p>
                    <address class="border rounded p-2 bg-light">
                        @_addressToDelete.FormattedAddress
                    </address>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDeleteAddress">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteAddress" disabled="@_isDeletingAddress">
                        @if (_isDeletingAddress)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Remove
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Add Address Modal -->
@if (_showAddAddressModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Address</h5>
                    <button type="button" class="btn-close" @onclick="CancelAddAddress"></button>
                </div>
                <EditForm Model="_newAddress" OnValidSubmit="AddAddress">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Address Type</label>
                                <InputSelect @bind-Value="_newAddress.Type" class="form-select">
                                    <option value="Billing">Billing</option>
                                    <option value="Shipping">Shipping</option>
                                    <option value="Office">Office</option>
                                    <option value="Other">Other</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mt-4">
                                    <InputCheckbox @bind-Value="_newAddress.IsDefault" class="form-check-input" id="isDefault" />
                                    <label class="form-check-label" for="isDefault">Set as default address</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Street Address</label>
                                <InputText @bind-Value="_newAddress.Street" class="form-control" />
                                <ValidationMessage For="() => _newAddress.Street" class="text-danger small" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Additional Line</label>
                                <InputText @bind-Value="_newAddress.AdditionalLine" class="form-control" placeholder="Apt, Suite, Building (optional)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">City</label>
                                <InputText @bind-Value="_newAddress.City" class="form-control" />
                                <ValidationMessage For="() => _newAddress.City" class="text-danger small" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">State/Province</label>
                                <InputText @bind-Value="_newAddress.State" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Postal Code</label>
                                <InputText @bind-Value="_newAddress.PostalCode" class="form-control" />
                                <ValidationMessage For="() => _newAddress.PostalCode" class="text-danger small" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Country</label>
                                <InputText @bind-Value="_newAddress.Country" class="form-control" />
                                <ValidationMessage For="() => _newAddress.Country" class="text-danger small" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelAddAddress">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@_isAddingAddress">
                            @if (_isAddingAddress)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Add Address
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CustomerDetailDto? _customer;
    private bool _isLoading = true;
    private bool _showDeleteModal = false;
    private bool _isDeleting = false;
    private CustomerAddressDto? _addressToDelete;
    private bool _isDeletingAddress = false;
    private bool _showAddAddressModal = false;
    private bool _isAddingAddress = false;
    private AddAddressRequest _newAddress = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomer();
    }

    private async Task LoadCustomer()
    {
        _isLoading = true;

        try
        {
            var response = await Http.GetAsync<CustomerDetailDto>($"api/customers/{Id}");

            if (response.Success)
            {
                _customer = response.Data;
            }
            else if (response.StatusCode == 404)
            {
                _customer = null;
            }
            else
            {
                ToastService.ShowError(response.Message ?? "Failed to load customer");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error loading customer: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ConfirmDelete()
    {
        _showDeleteModal = true;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _isDeleting = false;
    }

    private async Task DeleteCustomer()
    {
        _isDeleting = true;

        try
        {
            var response = await Http.DeleteAsync<object>($"api/customers/{Id}");

            if (response.Success)
            {
                ToastService.ShowSuccess($"Customer {_customer?.DisplayName} deleted successfully");
                Navigation.NavigateTo("customers");
            }
            else
            {
                ToastService.ShowError(response.Message ?? "Failed to delete customer");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting customer: {ex.Message}");
        }
        finally
        {
            _isDeleting = false;
            _showDeleteModal = false;
        }
    }

    private void ConfirmDeleteAddress(CustomerAddressDto address)
    {
        _addressToDelete = address;
    }

    private void CancelDeleteAddress()
    {
        _addressToDelete = null;
        _isDeletingAddress = false;
    }

    private async Task DeleteAddress()
    {
        if (_addressToDelete == null)
            return;

        _isDeletingAddress = true;

        try
        {
            var response = await Http.DeleteAsync<object>($"api/customers/{Id}/addresses/{_addressToDelete.Id}");

            if (response.Success)
            {
                ToastService.ShowSuccess("Address removed successfully");
                _addressToDelete = null;
                await LoadCustomer();
            }
            else
            {
                ToastService.ShowError(response.Message ?? "Failed to remove address");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error removing address: {ex.Message}");
        }
        finally
        {
            _isDeletingAddress = false;
        }
    }

    private void ShowAddAddressModal()
    {
        _newAddress = new AddAddressRequest();
        _showAddAddressModal = true;
    }

    private void CancelAddAddress()
    {
        _showAddAddressModal = false;
        _isAddingAddress = false;
    }

    private async Task AddAddress()
    {
        _isAddingAddress = true;

        try
        {
            var response = await Http.PostAsync<CustomerAddressDto>($"api/customers/{Id}/addresses", _newAddress);

            if (response.Success)
            {
                ToastService.ShowSuccess("Address added successfully");
                _showAddAddressModal = false;
                await LoadCustomer();
            }
            else
            {
                ToastService.ShowError(response.Message ?? "Failed to add address");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error adding address: {ex.Message}");
        }
        finally
        {
            _isAddingAddress = false;
        }
    }

    private static string GetStatusColor(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "active" => "success",
            "inactive" => "secondary",
            "suspended" => "warning",
            _ => "secondary"
        };
    }

    // DTO classes
    private class CustomerDetailDto
    {
        public Guid Id { get; set; }
        public string CustomerNumber { get; set; } = string.Empty;
        public string DisplayName => CompanyName ?? $"{FirstName} {LastName}";
        public string? CompanyName { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string? Mobile { get; set; }
        public string? Fax { get; set; }
        public string? Website { get; set; }
        public string? TaxId { get; set; }
        public string Status { get; set; } = string.Empty;
        public string? Notes { get; set; }
        public decimal? CreditLimit { get; set; }
        public int PaymentTermsDays { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime? ModifiedAt { get; set; }
        public IReadOnlyList<CustomerAddressDto> Addresses { get; set; } = Array.Empty<CustomerAddressDto>();
    }

    private class CustomerAddressDto
    {
        public Guid Id { get; set; }
        public string Type { get; set; } = string.Empty;
        public string Street { get; set; } = string.Empty;
        public string? AdditionalLine { get; set; }
        public string City { get; set; } = string.Empty;
        public string PostalCode { get; set; } = string.Empty;
        public string? State { get; set; }
        public string Country { get; set; } = string.Empty;
        public bool IsDefault { get; set; }
        public string FormattedAddress { get; set; } = string.Empty;
    }

    private class AddAddressRequest
    {
        public string Type { get; set; } = "Billing";
        [System.ComponentModel.DataAnnotations.Required]
        public string Street { get; set; } = string.Empty;
        public string? AdditionalLine { get; set; }
        [System.ComponentModel.DataAnnotations.Required]
        public string City { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required]
        public string PostalCode { get; set; } = string.Empty;
        public string? State { get; set; }
        [System.ComponentModel.DataAnnotations.Required]
        public string Country { get; set; } = string.Empty;
        public bool IsDefault { get; set; }
    }
}
