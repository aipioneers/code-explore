@page "/admin/users"
@attribute [Authorize(Roles = "Administrator")]
@inject HttpClientService Http
@inject NavigationManager Navigation
@inject IToastService ToastService

<PageTitle>Users - Admin - EnterpriseApp</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>User Management</h1>
    <button class="btn btn-primary" @onclick="ShowCreateModal">
        <i class="bi bi-plus-lg me-1"></i> New User
    </button>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search users..."
                           @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="_statusFilter" @bind:after="LoadUsers">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Suspended">Suspended</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="_roleFilter" @bind:after="LoadUsers">
                    <option value="">All Roles</option>
                    @foreach (var role in _roles)
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_users?.Items.Any() != true)
{
    <div class="text-center py-5">
        <i class="bi bi-people display-1 text-muted"></i>
        <p class="text-muted mt-3">No users found.</p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>2FA</th>
                        <th>Last Login</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in _users.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-medium">@user.FullName</div>
                                <small class="text-muted">@@@user.Username</small>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-secondary me-1">@role</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@GetStatusColor(user.Status)">@user.Status</span>
                            </td>
                            <td>
                                @if (user.TwoFactorEnabled)
                                {
                                    <i class="bi bi-shield-check text-success" title="2FA Enabled"></i>
                                }
                                else
                                {
                                    <i class="bi bi-shield text-muted" title="2FA Disabled"></i>
                                }
                            </td>
                            <td>
                                @if (user.LastLoginAt.HasValue)
                                {
                                    <span title="@user.LastLoginAt.Value.ToString("F")">
                                        @GetRelativeTime(user.LastLoginAt.Value)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">Never</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" title="Edit" @onclick="() => EditUser(user)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-warning" title="Reset Password" @onclick="() => ResetPassword(user)">
                                        <i class="bi bi-key"></i>
                                    </button>
                                    @if (user.Status == "Suspended")
                                    {
                                        <button class="btn btn-outline-success" title="Unlock" @onclick="() => UnlockUser(user)">
                                            <i class="bi bi-unlock"></i>
                                        </button>
                                    }
                                    <button class="btn btn-outline-danger" title="Delete" @onclick="() => ConfirmDelete(user)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Create/Edit User Modal -->
@if (_showUserModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingUser == null ? "Create User" : "Edit User")</h5>
                    <button type="button" class="btn-close" @onclick="HideUserModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Username</label>
                            <input type="text" class="form-control" @bind="_userForm.Username" disabled="@(_editingUser != null)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" @bind="_userForm.Email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">First Name</label>
                            <input type="text" class="form-control" @bind="_userForm.FirstName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Name</label>
                            <input type="text" class="form-control" @bind="_userForm.LastName" />
                        </div>
                        @if (_editingUser == null)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Password</label>
                                <input type="password" class="form-control" @bind="_userForm.Password" />
                            </div>
                        }
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input type="tel" class="form-control" @bind="_userForm.Phone" />
                        </div>
                        @if (_editingUser != null)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Status</label>
                                <select class="form-select" @bind="_userForm.Status">
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                    <option value="Suspended">Suspended</option>
                                </select>
                            </div>
                        }
                        <div class="col-12">
                            <label class="form-label">Roles</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var role in _roles)
                                {
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="role-@role.Id"
                                               checked="@_selectedRoles.Contains(role.Id)"
                                               @onchange="e => ToggleRole(role.Id, (bool)e.Value!)" />
                                        <label class="form-check-label" for="role-@role.Id">@role.Name</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideUserModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveUser" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        @(_editingUser == null ? "Create" : "Save")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PaginatedResponse<UserAdminDto>? _users;
    private List<RoleDto> _roles = new();
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private Guid? _roleFilter;
    private int _pageNumber = 1;
    private int _pageSize = 20;

    // User modal
    private bool _showUserModal = false;
    private UserAdminDto? _editingUser;
    private UserFormModel _userForm = new();
    private HashSet<Guid> _selectedRoles = new();
    private bool _isSaving = false;

    private System.Timers.Timer? _searchDebounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
        await LoadUsers();
    }

    private async Task LoadRoles()
    {
        try
        {
            var response = await Http.GetAsync<List<RoleDto>>("api/admin/roles");
            if (response.Success && response.Data != null)
            {
                _roles = response.Data;
            }
        }
        catch { }
    }

    private async Task LoadUsers()
    {
        _isLoading = true;
        try
        {
            var url = $"api/admin/users?pageNumber={_pageNumber}&pageSize={_pageSize}";
            if (!string.IsNullOrEmpty(_searchTerm)) url += $"&search={Uri.EscapeDataString(_searchTerm)}";
            if (!string.IsNullOrEmpty(_statusFilter)) url += $"&status={_statusFilter}";
            if (_roleFilter.HasValue) url += $"&roleId={_roleFilter}";

            var response = await Http.GetAsync<PaginatedResponse<UserAdminDto>>(url);
            if (response.Success && response.Data != null)
            {
                _users = response.Data;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        _searchDebounceTimer?.Stop();
        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = new System.Timers.Timer(300);
        _searchDebounceTimer.Elapsed += async (s, args) =>
        {
            _searchDebounceTimer?.Stop();
            _pageNumber = 1;
            await InvokeAsync(LoadUsers);
        };
        _searchDebounceTimer.AutoReset = false;
        _searchDebounceTimer.Start();
    }

    private void ShowCreateModal()
    {
        _editingUser = null;
        _userForm = new UserFormModel();
        _selectedRoles.Clear();
        _showUserModal = true;
    }

    private void EditUser(UserAdminDto user)
    {
        _editingUser = user;
        _userForm = new UserFormModel
        {
            Username = user.Username,
            Email = user.Email,
            FirstName = user.FirstName,
            LastName = user.LastName,
            Status = user.Status
        };
        _selectedRoles = new HashSet<Guid>(); // Would populate from user roles
        _showUserModal = true;
    }

    private void HideUserModal()
    {
        _showUserModal = false;
        _isSaving = false;
    }

    private void ToggleRole(Guid roleId, bool selected)
    {
        if (selected) _selectedRoles.Add(roleId);
        else _selectedRoles.Remove(roleId);
    }

    private async Task SaveUser()
    {
        _isSaving = true;
        try
        {
            var request = new
            {
                username = _userForm.Username,
                email = _userForm.Email,
                password = _userForm.Password,
                firstName = _userForm.FirstName,
                lastName = _userForm.LastName,
                phone = _userForm.Phone,
                status = _userForm.Status,
                roleIds = _selectedRoles.ToList()
            };

            ApiResponse<object> response;
            if (_editingUser == null)
            {
                response = await Http.PostAsync<object>("api/admin/users", request);
            }
            else
            {
                response = await Http.PutAsync<object>($"api/admin/users/{_editingUser.Id}", request);
            }

            if (response.Success)
            {
                ToastService.ShowSuccess(_editingUser == null ? "User created" : "User updated");
                HideUserModal();
                await LoadUsers();
            }
            else
            {
                ToastService.ShowError(response.Message ?? "Failed to save user");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ResetPassword(UserAdminDto user)
    {
        try
        {
            var response = await Http.PostAsync<object>($"api/admin/users/{user.Id}/reset-password", new { });
            if (response.Success)
            {
                ToastService.ShowSuccess("Password reset email sent");
            }
            else
            {
                ToastService.ShowError(response.Message ?? "Failed to reset password");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task UnlockUser(UserAdminDto user)
    {
        try
        {
            var response = await Http.PostAsync<object>($"api/admin/users/{user.Id}/unlock", new { });
            if (response.Success)
            {
                ToastService.ShowSuccess("User unlocked");
                await LoadUsers();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task ConfirmDelete(UserAdminDto user)
    {
        // Would show confirmation modal
        try
        {
            var response = await Http.DeleteAsync<object>($"api/admin/users/{user.Id}");
            if (response.Success)
            {
                ToastService.ShowSuccess("User deleted");
                await LoadUsers();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private static string GetStatusColor(string status) => status switch
    {
        "Active" => "success",
        "Inactive" => "secondary",
        "Suspended" => "danger",
        _ => "secondary"
    };

    private static string GetRelativeTime(DateTime dateTime)
    {
        var span = DateTime.UtcNow - dateTime;
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return dateTime.ToString("MMM d");
    }

    public void Dispose() => _searchDebounceTimer?.Dispose();

    // DTOs
    private class UserAdminDto
    {
        public Guid Id { get; set; }
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string FullName => $"{FirstName} {LastName}";
        public string Status { get; set; } = string.Empty;
        public bool TwoFactorEnabled { get; set; }
        public DateTime? LastLoginAt { get; set; }
        public IReadOnlyList<string> Roles { get; set; } = Array.Empty<string>();
    }

    private class RoleDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private class UserFormModel
    {
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string Status { get; set; } = "Active";
    }

    private class PaginatedResponse<T>
    {
        public IReadOnlyList<T> Items { get; set; } = Array.Empty<T>();
        public int TotalCount { get; set; }
    }
}
