@page "/admin/audit"
@attribute [Authorize(Roles = "Administrator")]
@inject HttpClientService Http
@inject IToastService ToastService

<PageTitle>Audit Log - Admin - EnterpriseApp</PageTitle>

<h1 class="mb-4">Audit Log</h1>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Search..."
                           @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                </div>
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="_actionFilter" @bind:after="LoadLogs">
                    <option value="">All Actions</option>
                    <option value="Create">Create</option>
                    <option value="Update">Update</option>
                    <option value="Delete">Delete</option>
                    <option value="Login">Login</option>
                    <option value="Logout">Logout</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="_entityFilter" @bind:after="LoadLogs">
                    <option value="">All Entities</option>
                    <option value="User">User</option>
                    <option value="Customer">Customer</option>
                    <option value="Product">Product</option>
                    <option value="Order">Order</option>
                    <option value="Document">Document</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" class="form-control" @bind="_fromDate" @bind:after="LoadLogs" />
            </div>
            <div class="col-md-2">
                <input type="date" class="form-control" @bind="_toDate" @bind:after="LoadLogs" />
            </div>
            <div class="col-md-1">
                <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_logs?.Items.Any() != true)
{
    <div class="text-center py-5">
        <i class="bi bi-clipboard display-1 text-muted"></i>
        <p class="text-muted mt-3">No audit logs found.</p>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Entity ID</th>
                        <th>IP Address</th>
                        <th class="text-end">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in _logs.Items)
                    {
                        <tr>
                            <td>
                                <span title="@log.CreatedAt.ToString("F")">
                                    @log.CreatedAt.ToString("g")
                                </span>
                            </td>
                            <td>@(log.Username ?? "System")</td>
                            <td>
                                <span class="badge bg-@GetActionColor(log.Action)">@log.Action</span>
                            </td>
                            <td>@log.EntityType</td>
                            <td>
                                <code class="small">@log.EntityId</code>
                            </td>
                            <td>
                                <code class="small">@(log.IpAddress ?? "—")</code>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowDetails(log)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (_logs.TotalPages > 1)
    {
        <nav class="mt-4">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted">
                    Showing @((_pageNumber - 1) * _pageSize + 1) to @Math.Min(_pageNumber * _pageSize, _logs.TotalCount) of @_logs.TotalCount
                </div>
                <ul class="pagination mb-0">
                    <li class="page-item @(!_logs.HasPreviousPage ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(_pageNumber - 1)">Previous</button>
                    </li>
                    <li class="page-item @(!_logs.HasNextPage ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(_pageNumber + 1)">Next</button>
                    </li>
                </ul>
            </div>
        </nav>
    }
}

<!-- Details Modal -->
@if (_selectedLog != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Audit Log Details</h5>
                    <button type="button" class="btn-close" @onclick="HideDetails"></button>
                </div>
                <div class="modal-body">
                    <dl class="row">
                        <dt class="col-sm-3">Timestamp</dt>
                        <dd class="col-sm-9">@_selectedLog.CreatedAt.ToString("F")</dd>

                        <dt class="col-sm-3">User</dt>
                        <dd class="col-sm-9">@(_selectedLog.Username ?? "System")</dd>

                        <dt class="col-sm-3">Action</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-@GetActionColor(_selectedLog.Action)">@_selectedLog.Action</span>
                        </dd>

                        <dt class="col-sm-3">Entity</dt>
                        <dd class="col-sm-9">@_selectedLog.EntityType (@_selectedLog.EntityId)</dd>

                        <dt class="col-sm-3">IP Address</dt>
                        <dd class="col-sm-9"><code>@(_selectedLog.IpAddress ?? "—")</code></dd>
                    </dl>

                    @if (!string.IsNullOrEmpty(_selectedLog.OldValues))
                    {
                        <h6>Old Values</h6>
                        <pre class="bg-light p-3 rounded"><code>@FormatJson(_selectedLog.OldValues)</code></pre>
                    }

                    @if (!string.IsNullOrEmpty(_selectedLog.NewValues))
                    {
                        <h6>New Values</h6>
                        <pre class="bg-light p-3 rounded"><code>@FormatJson(_selectedLog.NewValues)</code></pre>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideDetails">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PaginatedResponse<AuditLogDto>? _logs;
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private string _actionFilter = string.Empty;
    private string _entityFilter = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private int _pageNumber = 1;
    private int _pageSize = 50;
    private AuditLogDto? _selectedLog;
    private System.Timers.Timer? _searchDebounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        _isLoading = true;
        try
        {
            var url = $"api/admin/audit-logs?pageNumber={_pageNumber}&pageSize={_pageSize}";
            if (!string.IsNullOrEmpty(_searchTerm)) url += $"&search={Uri.EscapeDataString(_searchTerm)}";
            if (!string.IsNullOrEmpty(_actionFilter)) url += $"&action={_actionFilter}";
            if (!string.IsNullOrEmpty(_entityFilter)) url += $"&entityType={_entityFilter}";
            if (_fromDate.HasValue) url += $"&fromDate={_fromDate.Value:yyyy-MM-dd}";
            if (_toDate.HasValue) url += $"&toDate={_toDate.Value:yyyy-MM-dd}";

            var response = await Http.GetAsync<PaginatedResponse<AuditLogDto>>(url);
            if (response.Success && response.Data != null)
            {
                _logs = response.Data;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        _searchDebounceTimer?.Stop();
        _searchDebounceTimer?.Dispose();
        _searchDebounceTimer = new System.Timers.Timer(300);
        _searchDebounceTimer.Elapsed += async (s, args) =>
        {
            _searchDebounceTimer?.Stop();
            _pageNumber = 1;
            await InvokeAsync(LoadLogs);
        };
        _searchDebounceTimer.AutoReset = false;
        _searchDebounceTimer.Start();
    }

    private async Task ClearFilters()
    {
        _searchTerm = string.Empty;
        _actionFilter = string.Empty;
        _entityFilter = string.Empty;
        _fromDate = null;
        _toDate = null;
        _pageNumber = 1;
        await LoadLogs();
    }

    private async Task GoToPage(int page)
    {
        _pageNumber = page;
        await LoadLogs();
    }

    private void ShowDetails(AuditLogDto log) => _selectedLog = log;
    private void HideDetails() => _selectedLog = null;

    private static string GetActionColor(string action) => action switch
    {
        "Create" => "success",
        "Update" => "primary",
        "Delete" => "danger",
        "Login" => "info",
        "Logout" => "secondary",
        _ => "secondary"
    };

    private static string FormatJson(string json)
    {
        try
        {
            var obj = System.Text.Json.JsonSerializer.Deserialize<object>(json);
            return System.Text.Json.JsonSerializer.Serialize(obj, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    public void Dispose() => _searchDebounceTimer?.Dispose();

    private class AuditLogDto
    {
        public Guid Id { get; set; }
        public string? Username { get; set; }
        public string Action { get; set; } = string.Empty;
        public string EntityType { get; set; } = string.Empty;
        public string EntityId { get; set; } = string.Empty;
        public string? OldValues { get; set; }
        public string? NewValues { get; set; }
        public string? IpAddress { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    private class PaginatedResponse<T>
    {
        public IReadOnlyList<T> Items { get; set; } = Array.Empty<T>();
        public int PageNumber { get; set; }
        public int PageSize { get; set; }
        public int TotalCount { get; set; }
        public int TotalPages { get; set; }
        public bool HasPreviousPage { get; set; }
        public bool HasNextPage { get; set; }
    }
}
