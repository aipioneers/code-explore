{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=enterprise_dev;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "your-256-bit-secret-key-for-development-only-change-in-production",
    "Issuer": "enterprise-api",
    "Audience": "enterprise-web",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5000,https://localhost:5000"
  },
  "Storage": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "documents",
    "UseSSL": false
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "FromAddress": "noreply@enterprise-platform.local",
    "FromName": "Enterprise Platform"
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "EnableDetailedErrors": true
}
